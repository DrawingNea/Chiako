# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-token-here

# Optional: your test server's ID for instant slash-command updates during development
DEV_GUILD_ID=

# Database: fill in DB_HOST to use MySQL/MariaDB; leave it empty to use a local SQLite file
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# SQLite only: where the database file lives
DATABASE_PATH=dicebot.db
